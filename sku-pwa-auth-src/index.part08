const money=n=>(n>=0?'¥':'-¥')+Math.abs(n).toFixed(2);
const pct=n=>n.toFixed(1)+'%';
const rub=n=>'₽'+Math.round(n).toLocaleString();
const range=a=>a[0]===a[1]?String(a[0]):a[0]+'–'+a[1];
