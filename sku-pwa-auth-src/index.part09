t=`${i+1}｜${d.sku}｜${pct(d.margin)}`;s.appendChild(o)});
 if(current && [...s.options].some(o=>o.value===current))s.value=current; else s.value=sorted[0].rank;
 s.onchange=()=>renderDetail(Number(s.value));
}

const DASHBOARD_VERSION_DATE='2026-08-28';
const num=v=>Number.isFinite(Number(v))?Number(v):0;
const known=(d,k)=>Boolean(d && d[k]);
const fmtMoney=(v,ok=true)=>ok?`¥${num(v).toFixed(2)}`:'待补';
const fmtRub=(v,ok=true)=>ok?`${Math.round(num(v)).toLocaleString()} RUB`:'待补';
const fmtPct=(v,ok=true)=>ok?`${num(v).toFixed(1)}%`:'待补';
const fmtKg=(v,ok=true)=>ok?`${num(v).toFixed(3)} kg`:'待补';
const safeText=v=>(v===null||v===undefined||v===''||v==='待补/未闭环')?'待补':String(v);
const decisionOrPass=d=>known(d,'profitKnown')&&(num(d.profit)>10||num(d.margin)>15);\nconst rankEligible=d=>decisionOrPass(d)&&d.profitRankEligible!==false&&d.stage!=='STOP'&&d.pwaTier!=='STOP_AUDIT'&&d.pwaTier!=='CANDIDATE_PENDING';
const profitScore=d=>rankEligible(d)?num(d.profit):-1e15;
const marginScore=d=>rankEligible(d)?num(d.margin):-1e15;
function normalizeRow(d){const x={...d};['rank','price','cost','weight','cel','profit','margin','targetCost','ozonUnits','wbOrders','wbSearch','packageL','packageW','packageH','chargeWeight'].forEach(k=>x[k]=num(x[k]));x.links=x.links||{};x.ozForecast=Array.isArray(x.ozForecast)?x.ozForecast:[0,0];x.wbForecast=Array.isArray(x.wbForecast)?x.wbForecast:[0,0];x.totalForecast=Array.isArray(x.totalForecast)?x.totalForecast:[0,0];x.linkStatus=x.linkStatus||{};return x;}
function isStandaloneMode(){return window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone===true;}
async function copyExternalText(text){try{await navigator.clipboard.writeText(text);return true;}catch(e){return false;}}
function openPlatformLink(event,platform,url,sku){if(event)event.preventDefault();if(!url)return false;if(isStandaloneMode()){window.location.href=url;return false;}window.open(url,'_blank','noopener,noreferrer');return false;}
function linkStatus(url,explicit){if(explicit)return explicit;if(!url)return '待补';return /\/search\/|search\.aspx|search_result|search\/\?text/i.test(url)?'搜索入口｜待核精确商品':'商品页｜仍需人工复核';}
function statusBadge(d){if(d.stage==='STOP')return ['STOP审计','bad'];if(d.pwaTier==='CANDIDATE_PENDING')return ['候选待补','warn'];if(!known(d,'profitKnown'))return ['利润待补','warn'];if(!decisionOrPass(d))return ['OR闸门未通过','bad'];if(num(d.profit)>10&&num(d.margin)>15)return ['利润/利润率双过','good'];if(num(d.profit)>10)return ['单件利润>¥10','good'];return ['净利率>15%','good'];}
function quality(d){if(known(d,'profitKnown') && d.linkStatus && !String(d.linkStatus.supply||'').includes('待'))return 'B';if(known(d,'profitKnown'))return 'B';return 'C';}
function packageText(d){if(d.packageL>0&&d.packageW>0&&d.packageH>0)return `${d.packageL}×${d.packageW}×${d.packageH} cm`;return '待补';}
function supplierText(d){const p=safeText(d.supplyPlatform);const m=(d.moq!==null&&d.moq!==undefined&&String(d.moq)!==''&&num(d.moq)>0)?`MOQ ${num(d.moq).toLocaleString()}`:'MOQ待补';return `${p}｜${m}`;}
function reviewText(d){const v=safeText(d.reviewInsights);return v==='待补'?'待抓取真实竞品评论':v;}
async function manualRefresh(){const btn=document.getElementById('refreshBtn');if(btn){btn.disabled=true;btn.textContent='刷新中…';}try{if('serviceWorker' in navigator){const regs=await navigator.serviceWorker.getRegistrations();await Promise.all(regs.map(r=>r.update().catch(()=>{})));}if('caches' in window){const keys=await caches.keys();await Promise.all(keys.map(k=>caches.delete(k)));}}finally{const u=new URL(window.location.href);u.searchParams.set('_refresh',Date.now().toString());window.location.replace(u.toString());}}
function updateKpis(){const ks=document.querySelectorAll('.kpi');const calc=data.filter(rankEligible);if(ks[0]){ks[0].querySelector('b').textContent=data.length;ks[0].querySelector('span').textContent='全库产品卡';}if(ks[1]){ks[1].querySelector('b').textContent=calc.length;ks[1].querySelector('span').textContent='可参与净利润排名';}if(ks[2]){ks[2].querySelector('b').textContent=calc.length;ks[2].querySelector('span').textContent='跨境OR规则通过';}if(ks[3]){ks[3].querySelector('b').textContent=data.length-calc.length;ks[3].querySelector('span').textContent='候选待补 / STOP';}}
function upgradeLabels(){document.title='全库 SKU 选品产品卡';const foot=document.querySelector('.auth-foot');if(foot)foot.textContent='全库SKU数据已加密存储。关闭或重新加载页面后需要重新输入密码。';const hh=document.querySelector('.hero h1');if(hh)hh.textContent=`全库 ${data.length} SKU 选品决策驾驶舱`;const hp=document.querySelector('.hero p');if(hp)hp.textContent='全库产品卡 → 净利润排名 → 数据闭环 → 竞品差评 → 货源与竞品链接。未闭环SKU也进入产品卡，但不伪造利润排名。';const th=document.querySelectorAll('.ranking th');const labels=['排名','SKU','优先级','Ozon售价','采购成本','单件净利润','净利率','数据状态','更新时间'];labels.forEach((x,i)=>{if(th[i])th[i].textContent=x});const btn=document.querySelectorAll('.toggle button');if(btn[0])btn[0].textContent='按净利率';if(btn[1])btn[1].textContent='按单件利润';if(btn[2])btn[2].textContent='按主库顺序';const lock=document.getElementById('lockBtn');if(lock && !document.getElementById('refreshBtn')){const rb=document.createElement('button');rb.id='refreshBtn';rb.type='button';rb.className='lock-btn';rb.textContent='↻ 人工刷新';rb.title='清缓存并强制获取服务器最新版本';rb.style.marginRight='8px';rb.addEventListener('click',manualRefresh);lock.insertAdjacentElement('afterend',rb);}updateKpis();}
function renderSelect(){const s=document.getElementById('skuSelect');const current=s.value;s.innerHTML='';sorted.forEach(d=>{const o=document.createElement('option');o.value=d.rank;const p=d.stage==='STOP'?'STOP审计':rankEligible(d)?`${fmtMoney(d.profit)}｜${fmtPct(d.margin)}`:'候选待补';o.text=`主库${d.rank}｜${d.sku}｜${p}`;s.appendChild(o);});if(current && [...s.options].some(o=>o.value===current))s.value=current;else if(sorted[0])s.value=sorted[0].rank;s.onchange=()=>renderDetail(Number(s.value));}
function renderDetail(id){const d=data.find(x=>x.rank===id)||sorted[0];if(!d)return;const [bt,bc]=statusBadge(d),q=quality(d);const supplyState=linkStatus(d.links['1688'],d.linkStatus.supply);const wbState=linkStatus(d.links.wb,d.linkStatus.wb);const ozState=linkStatus(d.links.ozon,d.linkStatus.ozon);const review=reviewText(d);const reviewEvidence=safeText(d.reviewEvidence);const improvement=safeText(d.improvement);const blocker=safeText(d.blocker);const profitKnown=known(d,'profitKnown');const priceKnown=known(d,'priceKnown');const costKnown=known(d,'costKnown');const weightKnown=known(d,'weightKnown');document.getElementById('detail').innerHTML=`<div class="card"><div class="titleline"><div><h2>${d.sku}</h2><div class="family">产品卡｜${safeText(d.system)}｜${safeText(d.family)}｜优先级 ${safeText(d.priority)}</div></div><span class="badge ${bc}">${bt}</span></div><div style="margin-top:12px;padding:12px 14px;border:1px solid ${q==='B'?'#bfdbfe':'#fed7aa'};background:${q==='B'?'#eff6ff':'#fff7ed'};border-radius:14px;font-size:12px;line-height:1.65"><b>数据闭环等级：${q}</b> ｜ 主库行：${d.rank} ｜ 数据更新：${safeText(d.updated)} ｜ 研究状态：${safeText(d.researchStatus)}<br>${profitKnown?'当前净利润已可计算并参与排名。':'当前利润条件未闭环：产品卡保留，但不参与净利润排名。'}</div><div class="grid"><div class="metric"><small>Ozon当前/目标售价</small><strong>${fmtRub(d.price,priceKnown)}</strong><div class="sub">${safeText(d.officialCoverage)}</div></div><div class="metric"><small>实际/核价采购成本</small><strong>${fmtMoney(d.cost,costKnown)}</strong><div class="sub">${safeText(d.evidence)}</div></div><div class="metric"><small>单件跨境净利润</small><strong class="${profitKnown?(d.profit>=0?'pos':'neg'):''}">${fmtMoney(d.profit,profitKnown)}</strong><div class="sub">${profitKnown?'参与全库可计算SKU排名':'不可排名'}</div></div><div class="metric"><small>跨境净利率</small><strong class="${profitKnown?(d.margin>=15?'pos':'neg'):''}">${fmtPct(d.margin,profitKnown)}</strong><div class="sub">OR：利润&gt;¥10 或净利率&gt;15%</div></div><div class="metric"><small>15%采购上限</small><strong>${fmtMoney(d.targetCost,profitKnown&&d.targetCost>0)}</strong><div class="sub">${profitKnown&&d.targetCost<=0?'当前跨境模型不成立':'目标成本上限'}</div></div><div class="metric"><small>CEL计费</small><strong>${d.cel>0?`${d.cel.toFixed(2)} RUB`:'待补'}</strong><div class="sub">物流需随计费重复核</div></div><div class="metric"><small>毛重</small><strong>${fmtKg(d.weight,weightKnown)}</strong><div class="sub">包装/实称优先</div></div><div class="metric"><small>包装尺寸</small><strong>${packageText(d)}</strong><div class="sub">计费重：${d.chargeWeight>0?`${d.chargeWeight.toFixed(3)} kg`:'待补'}</div></div><div class="metric"><small>Ozon需求证据</small><strong>${d.ozonUnits>0?d.ozonUnits.toLocaleString():'待补'}</strong><div class="sub">${safeText(d.matchLevel)}</div></div><div class="metric"><small>WB需求证据</small><strong>${d.wbOrders>0?d.wbOrders.toLocaleString():'待补'}</strong><div class="sub">搜索/订单证据≠精确SKU销量</div></div><div class="metric"><small>供应商 / MOQ</small><strong>${supplierText(d)}</strong><div class="sub">${supplyState}</div></div><div class="metric"><small>唯一阻塞点</small><strong>${blocker}</strong><div class="sub">先解决最影响决策的一项</div></div></div><div class="spec"><b>产品规格：</b>${safeText(d.spec)}</div><div style="margin-top:14px;padding:14px;border:1px solid #fecaca;background:#fff7f7;border-radius:14px;font-size:13px;line-height:1.7"><b>竞品差评洞察</b><br><b>高频差评：</b>${review}<br><b>差评证据：</b>${reviewEvidence}<br><b>可改进 / 验货要求：</b>${improvement}</div><div class="links"><a href="${d.links['1688']||'#'}" target="_blank" rel="noopener">货源入口</a><a href="${d.links.taobao||'#'}" target="_blank" rel="noopener">淘宝货源</a><a href="${d.links.pdd||'#'}" target="_blank" rel="noopener">拼多多货源</a><a href="${d.links.wb||'#'}" onclick="return openPlatformLink(event,'WB',this.href,${JSON.stringify(d.sku)})" rel="noopener">WB竞品</a><a href="${d.links.ozon||'#'}" onclick="return openPlatformLink(event,'Ozon',this.href,${JSON.stringify(d.sku)})" rel="noopener">Ozon竞品</a></div><div class="note"><b>链接核验：</b>货源：${supplyState}；WB：${wbState}；Ozon：${ozState}。搜索入口不算精确竞品/精确货源，必须实际打开并核规格后才升级。</div></div>`;}
function renderTable(){const b=document.getElementById('tbody');b.innerHTML='';sorted.forEach((d,i)=>{const tr=document.createElement('tr');tr.onclick=()=>{document.getElementById('skuSelect').value=d.rank;renderDetail(d.rank);window.scrollTo({top:0,behavior:'smooth'})};const pk=known(d,'profitKnown');tr.innerHTML=`<td>${i+1}</td><td>${d.sku}</td><td>${safeText(d.priority)}</td><td>${fmtRub(d.price,known(d,'priceKnown'))}</td><td>${fmtMoney(d.cost,known(d,'costKnown'))}</td><td class="${pk?(d.profit>=0?'pos':'neg'):''}">${fmtMoney(d.profit,pk)}</td><td class="${pk?(d.margin>=15?'pos':'neg'):''}">${fmtPct(d.margin,pk)}</td><td>${pk?'可计算':'待补/不可排名'}</td><td>${safeText(d.updated)}</td>`;b.appendChild(tr);});}
function lifecycleText(d){if(d.stage==='STOP')return '已停止，保留审计卡，不参与净利润排名。';if(rankEligible(d))return '费用链已闭环且通过跨境OR规则，可参与净利润排名。';return '候选/待补，费用链未闭环，不参与净利润排名。';}
function supplierEvidenceHtml(d){const rows=Array.isArray(d.supplierLinks)?d.supplierLinks.filter(x=>x&&x.url):[];if(!rows.length)return '';return `<div class="note"><b>货源证据：</b>${rows.map((x,i)=>`<a href="${x.url}" target="_blank" rel="noopener">候选${i+1}</a>｜${safeText(x.match)}`).join('；')}</div>`;}
renderDetail=function(id){
  const d=data.find(x=>x.rank===id)||sorted[0];if(!d)return;
  const [bt,bc]=statusBadge(d),q=quality(d);
  const supplyState=linkStatus(d.links['1688'],d.linkStatus.supply);
  const wbState=linkStatus(d.links.wb,d.linkStatus.wb);
  const ozState=linkStatus(d.links.ozon,d.linkStatus.ozon);
  const review=reviewText(d),reviewEvidence=safeText(d.reviewEvidence),improvement=safeText(d.improvement),blocker=safeText(d.blocker);
  const profitKnown=known(d,'profitKnown'),profitEligible=rankEligible(d),priceKnown=known(d,'priceKnown'),costKnown=known(d,'costKnown'),weightKnown=known(d,'weightKnown');
  const stateLabel=d.stage==='STOP'?'STOP审计':profitEligible?'正式可排名':'候选待补';
  document.getElementById('detail').innerHTML=`<div class="card"><div class="titleline"><div><h2>${d.sku}</h2><div class="family">产品卡｜${safeText(d.system)}｜${safeText(d.family)}｜优先级 ${safeText(d.priority)}｜${stateLabel}</div></div><span class="badge ${bc}">${bt}</span></div><div style="margin-top:12px;padding:12px 14px;border:1px solid ${d.stage==='STOP'?'#fecaca':q==='B'?'#bfdbfe':'#fed7aa'};background:${d.stage==='STOP'?'#fff7f7':q==='B'?'#eff6ff':'#fff7ed'};border-radius:14px;font-size:12px;line-height:1.65"><b>数据闭环等级：${q}</b> ｜ 主库行：${d.rank} ｜ 决策排名：${d.decisionRank??'待补'} ｜ 阶段：${safeText(d.stage)} ｜ PWA层：${safeText(d.pwaTier)}<br>数据更新：${safeText(d.updated)} ｜ 研究状态：${safeText(d.researchStatus)}<br>${lifecycleText(d)}</div><div class="grid"><div class="metric"><small>Ozon当前/目标售价</small><strong>${fmtRub(d.price,priceKnown)}</strong><div class="sub">${safeText(d.officialCoverage)}</div></div><div class="metric"><small>实际/核价采购成本</small><strong>${fmtMoney(d.cost,costKnown)}</strong><div class="sub">${safeText(d.evidence)}</div></div><div class="metric"><small>单件跨境净利润</small><strong class="${profitKnown?(d.profit>=0?'pos':'neg'):''}">${fmtMoney(d.profit,profitKnown)}</strong><div class="sub">${profitEligible?'参与正式排名':d.stage==='STOP'?'仅供停止审计':'不可排名'}</div></div><div class="metric"><small>跨境净利率</small><strong class="${profitKnown?(d.margin>=15?'pos':'neg'):''}">${fmtPct(d.margin,profitKnown)}</strong><div class="sub">OR：利润&gt;¥10 或净利率&gt;15%</div></div><div class="metric"><small>15%采购上限</small><strong>${fmtMoney(d.targetCost,profitKnown&&d.targetCost>0)}</strong><div class="sub">${profitKnown&&d.targetCost<=0?'当前跨境模型不成立':'目标成本上限'}</div></div><div class="metric"><small>CEL计费</small><strong>${d.cel>0?`${d.cel.toFixed(2)} RUB`:'待补'}</strong><div class="sub">物流需随计费重复核</div></div><div class="metric"><small>毛重</small><strong>${fmtKg(d.weight,weightKnown)}</strong><div class="sub">包装/实称优先</div></div><div class="metric"><small>包装尺寸</small><strong>${packageText(d)}</strong><div class="sub">计费重：${d.chargeWeight>0?`${d.chargeWeight.toFixed(3)} kg`:'待补'}</div></div><div class="metric"><small>Ozon需求证据</small><strong>${d.ozonUnits>0?d.ozonUnits.toLocaleString():'待补'}</strong><div class="sub">${safeText(d.matchLevel)}</div></div><div class="metric"><small>WB需求证据</small><strong>${d.wbOrders>0?d.wbOrders.toLocaleString():'待补'}</strong><div class="sub">搜索/订单证据≠精确SKU销量</div></div><div class="metric"><small>供应商 / MOQ</small><strong>${supplierText(d)}</strong><div class="sub">${supplyState}</div></div><div class="metric"><small>唯一阻塞点</small><strong>${blocker}</strong><div class="sub">先解决最影响决策的一项</div></div></div><div class="spec"><b>产品规格：</b>${safeText(d.spec)}</div><div style="margin-top:14px;padding:14px;border:1px solid #fecaca;background:#fff7f7;border-radius:14px;font-size:13px;line-height:1.7"><b>竞品差评洞察</b><br><b>高频差评：</b>${review}<br><b>差评证据：</b>${reviewEvidence}<br><b>可改进 / 验货要求：</b>${improvement}</div><div class="links"><a href="${d.links['1688']||'#'}" target="_blank" rel="noopener">货源入口</a><a href="${d.links.taobao||'#'}" target="_blank" rel="noopener">淘宝货源</a><a href="${d.links.pdd||'#'}" target="_blank" rel="noopener">拼多多货源</a><a href="${d.links.wb||'#'}" onclick="return openPlatformLink(event,'WB',this.href,${JSON.stringify(d.sku)})" rel="noopener">WB竞品</a><a href="${d.links.ozon||'#'}" onclick="return openPlatformLink(event,'Ozon',this.href,${JSON.stringify(d.sku)})" rel="noopener">Ozon竞品</a></div>${supplierEvidenceHtml(d)}<div class="note"><b>链接核验：</b>货源：${supplyState}；WB：${wbState}；Ozon：${ozState}。搜索入口不算精确竞品/精确货源，必须实际打开并核规格后才升级。</div></div>`;
};
function formalProfitRanks(){return new Map([...data].filter(rankEligible).sort((a,b)=>profitScore(b)-profitScore(a)||a.rank-b.rank).map((d,i)=>[d.rank,i+1]));}
renderTable=function(){const b=document.getElementById('tbody'),ranks=formalProfitRanks();b.innerHTML='';sorted.forEach(d=>{const tr=document.createElement('tr');tr.onclick=()=>{document.getElementById('skuSelect').value=d.rank;renderDetail(d.rank);window.scrollTo({top:0,behavior:'smooth'})};const pk=known(d,'profitKnown'),pe=rankEligible(d),state=d.stage==='STOP'?'STOP审计':pe?'可排名':'候选待补',formalRank=ranks.get(d.rank);tr.innerHTML=`<td>${formalRank??'—'}</td><td>${d.sku}</td><td>${safeText(d.priority)}</td><td>${fmtRub(d.price,known(d,'priceKnown'))}</td><td>${fmtMoney(d.cost,known(d,'costKnown'))}</td><td class="${pk?(d.profit>=0?'pos':'neg'):''}">${fmtMoney(d.profit,pk)}</td><td class="${pk?(d.margin>=15?'pos':'neg'):''}">${fmtPct(d.margin,pk)}</td><td>${state}</td><td>${safeText(d.updated)}</td>`;b.appendChild(tr);});};
function sortBy(k){if(k==='margin')sorted.sort((a,b)=>marginScore(b)-marginScore(a)||a.rank-b.rank);else if(k==='profit')sorted.sort((a,b)=>profitScore(b)-profitScore(a)||a.rank-b.rank);else sorted.sort((a,b)=>a.rank-b.rank);renderSelect();renderTable();if(sorted[0])renderDetail(Number(document.getElementById('skuSelect').value||sorted[0].rank));}
const HYBRID_KEYRING=__HYBRID_KEYRING__;
const b64bytes=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0));
async function gunzipBytes(bytes){if(typeof DecompressionStream==='undefined')throw new Error('gzip unsupported');const ds=new DecompressionStream('gzip');const stream=new Blob([bytes]).stream().pipeThrough(ds);return new Uint8Array(await new Response(stream).arrayBuffer());}
async function decryptLegacyPayload(password){const te=new TextEncoder(),td=new TextDecoder();const keyMaterial=await crypto.subtle.importKey('raw',te.encode(password),'PBKDF2',false,['deriveKey']);const key=await crypto.subtle.deriveKey({name:'PBKDF2',salt:b64bytes(ENCRYPTED_PAYLOAD.salt),iterations:ENCRYPTED_PAYLOAD.iterations,hash:'SHA-256'},keyMaterial,{name:'AES-GCM',length:256},false,['decrypt']);let plain=new Uint8Array(await crypto.subtle.decrypt({name:'AES-GCM',iv:b64bytes(ENCRYPTED_PAYLOAD.iv),additionalData:te.encode(ENCRYPTED_PAYLOAD.aad)},key,b64bytes(ENCRYPTED_PAYLOAD.cipher)));if(ENCRYPTED_PAYLOAD.compressed==='gzip')plain=await gunzipBytes(plain);return JSON.parse(td.decode(plain));}
async function decryptHybridPayload(password){const te=new TextEncoder(),td=new TextDecoder(),env=ENCRYPTED_PAYLOAD,ring=HYBRID_KEYRING,w=ring&&ring.wrappedPrivateKey,kw=env&&env.keyWrapping,de=env&&env.dataEncryption;if(!w||!kw||!de||ring.kind!=='SKU-PWA-HYBRID-KEYRING'||env.kind!=='SKU-PWA-HYBRID-ENVELOPE')throw new Error('hybrid schema');if(kw.publicKeyFingerprintSha256!==ring.publicKey.fingerprintSha256)throw new Error('hybrid key mismatch');const material=await crypto.subtle.importKey('raw',te.encode(password),'PBKDF2',false,['deriveKey']);const wrapKey=await crypto.subtle.deriveKey({name:'PBKDF2',salt:b64bytes(w.salt),iterations:w.iterations,hash:'SHA-256'},material,{name:'AES-GCM',length:256},false,['decrypt']);const privateDer=await crypto.subtle.decrypt({name:'AES-GCM',iv:b64bytes(w.iv),additionalData:te.encode(w.aad)},wrapKey,b64bytes(w.ciphertext));const privateKey=await crypto.subtle.importKey('pkcs8',privateDer,{name:'RSA-OAEP',hash:'SHA-256'},false,['decrypt']);const rawDataKey=await crypto.subtle.decrypt({name:'RSA-OAEP'},privateKey,b64bytes(kw.wrappedKey));const dataKey=await crypto.subtle.importKey('raw',rawDataKey,{name:'AES-GCM'},false,['decrypt']);let plain=new Uint8Array(await crypto.subtle.decrypt({name:'AES-GCM',iv:b64bytes(de.iv),additionalData:te.encode(de.aad)},dataKey,b64bytes(de.ciphertext)));if(env.compression==='gzip')plain=await gunzipBytes(plain);else throw new Error('hybrid compression');const decoded=JSON.parse(td.decode(plain));if(env.records!==undefined&&env.records!==decoded.length)throw new Error('record count mismatch');return decoded;}
async function decryptPayload(password){return ENCRYPTED_PAYLOAD&&ENCRYPTED_PAYLOAD.kind==='SKU-PWA-HYBRID-ENVELOPE'?decryptHybridPayload(password):decryptLegacyPayload(password);}
async function unlockWithPassword(password){const btn=document.getElementById('loginBtn'),err=document.getElementById('authError');btn.disabled=true;btn.textContent='验证中…';err.textContent='';try{const decoded=await decryptPayload(password);if(!Array.isArray(decoded)||decoded.length<1)throw new Error('payload');data=decoded.map(normalizeRow);sorted=[...data];document.getElementById('authPassword').value='';document.getElementById('authScreen').hidden=true;document.getElementById('appRoot').hidden=false;upgradeLabels();sortBy('profit');return true;}catch(e){data=[];sorted=[];err.textContent=(String(e&&e.message).includes('gzip unsupported'))?'当前浏览器版本不支持全库压缩解密，请升级iOS/Safari。':'密码错误或数据版本异常，请重新输入。';return false;}finally{btn.disabled=false;btn.textContent='登录';}}
function lockApp(){data=[];sorted=[];document.getElementById('skuSelect').innerHTML='';document.getElementById('detail').innerHTML='';document.getElementById('tbody').innerHTML='';document.getElementById('appRoot').hidden=true;document.getElementById('authScreen').hidden=false;const p=document.getElementById('authPassword');p.value='';p.focus();}
document.title='全库 SKU 选品产品卡';const initialFoot=document.querySelector('.auth-foot');if(initialFoot)initialFoot.textContent='全库SKU数据已加密存储。关闭或重新加载页面后需要重新输入密码。';document.getElementById('authForm').addEventListener('submit',async e=>{e.preventDefault();await unlockWithPassword(document.getElementById('authPassword').value)});document.getElementById('lockBtn').addEventListener('click',lockApp);setTimeout(()=>document.getElementById('authPassword').focus(),100);if('serviceWorker' in navigator){const tokenSource=ENCRYPTED_PAYLOAD.salt||ENCRYPTED_PAYLOAD.dataEncryption?.iv||ENCRYPTED_PAYLOAD.keyWrapping?.wrappedKey||'build';const swToken=`v1-6-${String(tokenSource).replace(/[^A-Za-z0-9]/g,'').slice(0,12)}`;window.addEventListener('load',()=>navigator.serviceWorker.register(`./sw.js?v=${encodeURIComponent(swToken)}`).catch(()=>{}));}const standalone=window.matchMedia('(display-mode: standalone)').matches||window.navigator.standalone===true;const isIOS=/iphone|ipad|ipod/i.test(navigator.userAgent);if(isIOS&&!standalone&&!localStorage.getItem('pwaTipHidden')){setTimeout(()=>{const el=document.getElementById('installTip');if(el)el.style.display='block'},1200);}
</script></body></html>
